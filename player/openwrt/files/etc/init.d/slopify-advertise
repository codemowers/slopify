#!/bin/sh /etc/rc.common
# Advertises the Pulse receiver over mDNS under the player name. Discovery is
# not authentication.

START=95
STOP=05
USE_PROCD=1

. /usr/libexec/slopify/common.sh

start_service() {
	local pulse listen name
	config_load slopify
	config_get_bool pulse player pulse 1
	config_get listen player local_listen ':8080'
	[ "$pulse" = 1 ] && [ -n "$listen" ] || return 0
	name="$(slopify_name)"
	procd_open_instance
	procd_set_param command /usr/bin/avahi-publish-service --no-fail "$name" _pulse-sink._tcp 4713 \
		device=slopify.output "description=$name" format=s32le rate=48000 channels=2 \
		channel_map=front-left,front-right
	procd_set_param user nobody
	procd_set_param group nogroup
	procd_set_param respawn 3600 3 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger slopify system
}
