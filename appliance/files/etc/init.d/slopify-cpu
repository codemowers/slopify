#!/bin/sh /etc/rc.common
# Apply before the audio player; each CPUFreq policy reports its own minimum.
START=89

start() {
	local enabled policy minimum governors failed=0
	config_load slopify
	config_get_bool enabled cpu minimum 1
	[ "$enabled" = 1 ] || return 0
	for policy in /sys/devices/system/cpu/cpufreq/policy*; do
		[ -d "$policy" ] || continue
		minimum=$(cat "$policy/cpuinfo_min_freq") || { failed=1; continue; }
		case "$minimum" in ''|*[!0-9]*|0) failed=1; continue ;; esac
		if ! { echo "$minimum" > "$policy/scaling_min_freq" &&
		       echo "$minimum" > "$policy/scaling_max_freq"; }; then
			logger -t slopify-cpu "Failed to pin ${policy##*/} to $minimum kHz"
			failed=1
			continue
		fi
		governors=$(cat "$policy/scaling_available_governors")
		case " $governors " in
			*' powersave '*) echo powersave > "$policy/scaling_governor" || failed=1 ;;
		esac
	done
	return "$failed"
}
